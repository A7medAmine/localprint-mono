# Server environment: "development" or "production"
# NODE_ENV=development
NODE_ENV=production

# Server port (default 3001 dev / 3000 prod)
# PORT=3000

# Supabase project URL and service role key (NOT the anon/public key)
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Shared secret between this cloud app and the desktop LocalPrint app
# The desktop app's cloudSync.js must use the same token value
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHOP_API_TOKEN=your_64_char_hex_token_here

# Platform-admin bearer token — guards /api/admin/shops* and the
# /platform-admin console (create shops, rotate shop tokens, deactivate).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_ADMIN_TOKEN=your_platform_admin_token_here

# Dev-only CORS origin for the Vite dev server. Not used in production.
DEV_CORS_ORIGIN=http://localhost:5000

# Optional customer accounts (email/password + Google via Supabase Auth).
# These are read by the Vite frontend (VITE_ prefix required) — the anon/public
# key, NOT the service role key. Get it from Supabase dashboard → Settings → API.
# Leave unset to disable customer accounts entirely; guest upload is unaffected.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
