{
  "name": "@localprint/desktop",
  "private": true,
  "version": "0.1.4",
  "description": "PrintShop Hub — desktop print-shop management app (jobs, native printing, QR uploads).",
  "author": "PrintShop Hub",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node server.js",
    "dev": "cross-env NODE_ENV=development concurrently \"vite\" \"node server.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "server": "node server.js",
    "frontend": "vite",
    "backend": "node server.js",
    "electron": "cross-env NODE_ENV=production electron .",
    "electron:dev": "cross-env NODE_ENV=development VITE_API_TARGET=http://localhost:47821 concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"electron .\"",
    "electron:build": "node scripts/generate-packaged-env.js && node scripts/bundle-shared.js && npm run build && electron-builder --win nsis",
    "electron:release": "node scripts/generate-packaged-env.js && node scripts/bundle-shared.js && npm run build && electron-builder --win nsis --publish always",
    "rebuild:node": "npm rebuild better-sqlite3 --build-from-source",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3 && node scripts/patch-pdfjs-worker.js"
  },
  "dependencies": {
    "@localprint/shared": "0.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toast": "^1.2.15",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "postcss": "^8.5.14",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.printshop.hub",
    "productName": "PrintShop Hub",
    "copyright": "Copyright © PrintShop Hub",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      ".env.packaged",
      "server.js",
      "db.js",
      "checkEnv.js",
      "migrate.js",
      "migrations/**/*",
      "services/**/*",
      "utils/**/*",
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "A7medAmine",
      "repo": "localprint-mono",
      "releaseType": "release"
    },
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "PrintShop-Hub-Setup-${version}.${ext}"
    },
    "protocols": [
      {
        "name": "PrintShop Hub",
        "schemes": [
          "printshop-hub"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrintShop Hub",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
