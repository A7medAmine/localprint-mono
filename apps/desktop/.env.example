# Server environment: "development" or "production"
# NODE_ENV=development
NODE_ENV=production

# Gmail OAuth redirect URI — must match the URI configured in Google Cloud Console
# For local dev: http://localhost:3001/api/gmail/callback
# For production: https://your-domain.com/api/gmail/callback
GMAIL_REDIRECT_URI=http://localhost:3001/api/gmail/callback

# Google Cloud OAuth credentials — get these from Google Cloud Console
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Token encryption key (32 bytes, hex-encoded) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_32_byte_hex_key_here

# Admin session token lifetime (days). Idle = logged out after this long with
# no requests; Max = hard cap regardless of activity.
ADMIN_TOKEN_IDLE_DAYS=14
ADMIN_TOKEN_MAX_DAYS=30

# Dev-only CORS origin for the Vite dev server. Not used in packaged builds.
DEV_CORS_ORIGIN=http://localhost:3000

# Cloud sync — configure Cloud Sync URL and API Token in Settings → Cloud Sync
