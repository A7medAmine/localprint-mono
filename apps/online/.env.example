# Generate this file interactively instead of copying it by hand:
#   node scripts/setup-env.js
#
# Every value below is read by the app. Nothing here is optional-but-ignored —
# if a variable is not listed here, the code does not read it.

# ── Required ──────────────────────────────────────────────────────────────

# Supabase project URL — Project Settings → API.
SUPABASE_URL=https://your-project.supabase.co

# Supabase service_role key — Project Settings → API.
# NOT the anon/publishable key. Server-side only; it bypasses RLS.
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── Platform admin console (/platform-admin) ──────────────────────────────
# Create shops, rotate shop tokens, activate/deactivate.
# Hash generated by: node scripts/admin-password.js "<password>" --write

PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD_HASH=scrypt:16384:8:1:<salt>:<hash>

# Optional machine bearer for the same /api/admin/* endpoints (scripts, curl,
# CI). The console login above does not need it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#PLATFORM_ADMIN_TOKEN=

# ── Optional: customer accounts ───────────────────────────────────────────
# Email/password + Google sign-in via Supabase Auth. Leave unset to run
# guest-upload only. Read by the Vite frontend, so they must be present at
# BUILD time (not just at runtime) and must be the anon/publishable key.

#VITE_SUPABASE_URL=https://your-project.supabase.co
#VITE_SUPABASE_ANON_KEY=your_anon_publishable_key_here

# ── Optional: runtime ─────────────────────────────────────────────────────

#NODE_ENV=production
#PORT=3000
#HOST=127.0.0.1
# Public origin of this deployment; used by scripts/create-shop.js to print
# the shop's upload link.
#PUBLIC_URL=https://cloud.example.com
# Extra CORS origin allowed in development (default http://localhost:5000).
#DEV_CORS_ORIGIN=http://localhost:5000
