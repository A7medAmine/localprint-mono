# Dependencies (hoisted to root by npm workspaces)
node_modules

# Build output
dist
dist-ssr
release
build

# ...except apps/desktop/build, which is electron-builder's buildResources
# directory: committed source assets (the app icon), not build output.
!apps/desktop/build/
!apps/desktop/build/**

# Runtime data
uploads
*.sqlite
*.sqlite-shm
*.sqlite-wal
db.json

# Secrets — never commit
.env
.env.packaged
env
*.local

# Local tooling
.codegraph/
.DS_Store
*.log

# Print engine binary — fetched by scripts/fetch-sumatrapdf.js, never committed
apps/desktop/resources/print/*.exe
